# Copy to the private WSL service-home/config/service.env and fill every blank.
NODE_ENV=production
DEPLOYMENT_ENV=local
PORT=13601
METRICS_PORT=13602
RAFT_DATA_ROOT=/opt/raft/data
POSTGRES_PASSWORD=
DATABASE_URL=
RISINGWAVE_DATABASE_URL=postgresql://root@127.0.0.1:17666/dev
REDIS_URL=redis://127.0.0.1:16379
JWT_SECRET=
AGENT_API_KEY_HMAC_SECRET=
AGENT_BOOTSTRAP_TOKEN_PEPPER=
SLOCK_PROVIDER_CREDENTIAL_KEY=
SLOCK_DEVICE_LOGIN_ENABLED=true
SERVER_URL=http://localhost:13600
APP_URL=http://localhost:13600
CORS_ORIGIN=http://localhost:13600,http://127.0.0.1:13600
SLOCK_HOME=/opt/raft/data/home
UPLOADS_DIR=/opt/raft/data/uploads
UPLOADS_LOCAL=true
